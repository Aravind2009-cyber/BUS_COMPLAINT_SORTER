# LLM API Configuration Template
# Copy this file to '.env' and insert your personal API key if using cloud LLM.
# Note: DO NOT commit your actual '.env' file to GitHub!

# Running in Local Intelligent Engine mode (default)
USE_LOCAL_SIMULATOR=true

# Optional: To use external LLMs
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here
